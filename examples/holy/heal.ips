// Heal: petals of light bloom round the feet one by one, leaning out as
// they open; a hoop of light rises up the body (its far half behind, its
// near half in front), leaving sparkles where it passes, and bursts at the
// top; motes spiral up round the body on trails of light and pop into tiny
// hearts or twinkles; then the petals fold away.
//
// Category: holy. One-shot. Canvas 80x104, origin 40,92 (the floor under the
// healed character, who stands on the origin: the effect is drawn round a
// 24x38 body without drawing it). Side view, light from the upper left.
// Frames: the seed rolls 24, 30 or 36 frames over 1.55-1.75 s; `frames`
// retimes it.
// Light: the mask holds the petals' rims and glowing tips, the hoop, the
// motes and their hearts, the burst at the top and a light-only pool under
// the flower; power holds round 2.2 and flares to about 4 with the burst,
// sigma 9, blur 2.
//   tint   transparent rolls the colour (45% healing green, 35% holy gold,
//          20% mana aqua); a colour recolours the effect
//
// Variety: medium
asset Heal {
  size 80x104
  origin 40,92

  // ---- the effect contract -------------------------------------------------
  // 0 draws the hero frame; 1..frames play the effect; past its end a
  // one-shot draws nothing.
  input u32 frame = 0
  // 0 rolls the frame count from the seed; 2..64 retimes the effect.
  input u32 frames = 0
  // 0 colour sprite, 1 light mask, 2 light under the pixels (the mask with
  // power, sigma and blur applied, ready to add under the sprite).
  input u32 renderPass = 0
  // 0 keeps this frame's own value; above 0 forces it.
  input f32 power = 0.0
  input f32 sigma = 0.0
  input f32 blur = 0.0
  // Transparent rolls the colour from the seed; a colour recolours it.
  input color tint = #00000000

  // {frames, fps, loop (1) or one-shot (0), the frame drawn (0 when done)}
  output rect anim
  // {x: power, y: sigma, radius: blur} of this frame's light
  output circle glow

  palette green = [#0e2a24, #14472f, #1d6e3a, #2f9a45, #5cc654, #a0e46c, #dcffb4, #ffffff]
  palette gold = [#3b1d2a, #7a3a2c, #c4652e, #f0a040, #ffd25e, #fff0a0, #fffbe0, #ffffff]
  palette aqua = [#0a1e3a, #123a6a, #1a64a4, #2a98d8, #58c8f0, #a0e8ff, #e0faff, #ffffff]

  const distribution looks = weighted {1: 45, 2: 35, 3: 20}
  const f32 heroPhase = 0.3
  const f32 sigmaMax = 12.0
  const f32 cx = 40.0
  const f32 floorY = 92.0
  const f32 tau = 6.28318
  // The floor's tilt: rings on it are this much as tall as they are wide.
  const f32 sy = 0.3
  // The hoop rises from the floor to just over the head between these times.
  const f32 lift0 = 0.16
  const f32 lift1 = 0.74
  const f32 topY = -43.0
  const f32 ringR = 16.0
  const f32 natural = 1.8

  // Stream keys, one per purpose; per-particle streams add i * 0x9e3779b1.
  const i32 timeKey = 0x68e31da4
  const i32 lookKey = 0x2f6b9a13
  const i32 petalKey = 0x1b873593
  const i32 moteKey = 0x2545f491
  const i32 starKey = 0x3c6ef372

  draw {
    start = seed
    // ---- timing: the seed's own frame count, or the one asked for ----------
    stream_push(hash(start ^ timeKey))
    rolled = pick(24, 30, 36)
    dur = 1.55 to 1.75
    stream_pop()
    n = rolled
    if (frames >= 2) { n = min(frames, 64) }
    f = frame
    if (f == 0) { f = clamp(int(heroPhase * float(n)) + 1, 1, n) }
    // The effect is choreographed over `natural` seconds; the seed's duration
    // plays it a little faster or slower, so it always ends with the last frame.
    t = (float(f) - 0.5) / float(n) * natural

    // ---- the look: roll everything, whatever the inputs --------------------
    stream_push(hash(start ^ lookKey))
    kind = 1 to 3 with looks
    petals = 6 to 9
    spin = 0.25 to 0.55
    if (chance(0.5)) { spin = -spin }
    hearts = chance(0.7)
    stream_pop()
    cs = green
    if (kind == 2) { cs = gold }
    if (kind == 3) { cs = aqua }
    if (tint.a != 0) { cs = rampFrom(tint) }

    // ---- this frame's light ------------------------------------------------
    flare = 0.0
    if (t > lift1) { flare = exp(-(t - lift1) / 0.25) }
    lp = (2.2 + 1.8 * flare) * smoothstep(0.03, 0.14, t) * (1.0 - smoothstep(0.7 * natural, 0.92 * natural, t))
    ls = 9.0
    lb = 2.0
    if (power > 0.0) { lp = power }
    if (sigma > 0.0) { ls = sigma }
    if (blur > 0.0) { lb = blur }
    lp = clamp(lp, 0.0, 16.0)
    ls = clamp(ls, 0.0, sigmaMax)
    lb = clamp(lb, 0.0, 4.0)
    shown = f
    if (f > n) {
      shown = 0
      lp = 0.0
    }
    anim = {float(n), float(n) / dur, 0.0, float(shown)}
    glow = {lp, ls, lb}

    // ---- the passes (keep as is) -------------------------------------------
    if (f <= n) {
      if (renderPass == 1) {
        layer mask1(alpha = surface.source_over) { scene(start, t, cs, petals, spin, hearts, 1, 1.0) }
        surface.paint(mask1, blend = surface.source_over)
      } else if (renderPass == 2) {
        if (lp > 0.0) {
          k = max(1, int(ceil(lp)))
          layer mask2(alpha = surface.source_over) { scene(start, t, cs, petals, spin, hearts, 1, lp / float(k)) }
          pool = mask2.blur(ls)
          bloom = mask2.blur(lb)
          for i in 0..k { surface.paint(pool, blend = surface.source_over) }
          for i in 0..k { surface.paint(bloom, blend = surface.source_over) }
        }
      } else {
        layer sprite(alpha = surface.source_over) { scene(start, t, cs, petals, spin, hearts, 0, 1.0) }
        surface.paint(sprite, blend = surface.source_over)
      }
    }
  }

  // Everything at time t, back to front: the far petals, the hoop's far half
  // and the motes behind the body, then the sparkles, the near petals, the
  // hoop's near half and the motes in front. pass 0 paints colour; pass 1
  // paints only what emits light, alpha scaled by amp.
  scene(start: i32, t: f32, cs: list<color>, petals: i32, spin: f32, hearts: i32, pass: i32, amp: f32) {
    if (pass == 1) {
      // Light only: a warm pool under the flower.
      pool = smoothstep(0.0, 0.2, t) * (1.0 - smoothstep(0.7 * natural, 0.95 * natural, t))
      for i in 0..3 {
        shrink = 1.0 - float(i) * 0.3
        oval(cx, floorY - 1.0, 22.0 * shrink, 6.0 * shrink, ink(cs[4], (0.15 + 0.1 * float(i)) * pool * amp))
      }
    }
    for k in 0..petals { petal(start, k, petals, t, spin, cs, 0, pass, amp) }
    hoop(t, cs, 0, pass, amp)
    riders(start, t, cs, petals, spin, hearts, 1, pass, amp)
    stars(start, t, cs, pass, amp)
    for k in 0..petals { petal(start, k, petals, t, spin, cs, 1, pass, amp) }
    hoop(t, cs, 1, pass, amp)
    // The burst as the hoop tops out: a sparkle and a flash of light.
    if (t >= lift1) {
      top = {cx, floorY + topY}
      g = t - lift1
      if (g < 0.25) { sparkle(top, 8.0 * (1.0 - g / 0.25), cs, pass, amp) }
      if (pass == 1) {
        haze(top, 15.0, cs[5], 0.35 * exp(-g / 0.25) * amp)
        haze(top, 7.0, cs[7], 0.4 * exp(-g / 0.08) * amp)
      }
    }
    riders(start, t, cs, petals, spin, hearts, 0, pass, amp)
    // A last glint lingers over the flower's heart and fades with the effect.
    if (t > 1.35) {
      g = clamp((t - 1.35) / (natural - 1.35), 0.0, 1.0)
      gk = 1.0 - g
      if (pass == 1) { gk = gk * amp }
      rect(cx, floorY - 4.0, 1.0, 1.0, ink(cs[7], gk))
      if (g < 0.6) { sparkle({cx, floorY - 4.0}, 2.5 * (1.0 - g), cs, pass, amp * (1.0 - g)) }
    }
  }

  // How open petal k is at time t: it springs open on its own beat and folds
  // away near the end.
  bloom(t: f32, t0: f32, k: i32) -> f32 {
    shut = 1.25 + float(k) * 0.02
    return easeOutBack(seg(t, t0, t0 + 0.3), 1.8) * (1.0 - easeInBack(seg(t, shut, shut + 0.35), 1.4))
  }

  // A petal of the lotus of light round the feet: rooted on a ring on the
  // floor, leaning out as it opens, foreshortened as it turns away; a lit
  // rim, a pale vein, a translucent body, a white tip. near picks the half of
  // the ring to draw (0 behind the body, 1 in front of it).
  petal(start: i32, k: i32, np: i32, t: f32, spin: f32, cs: list<color>, near: i32, pass: i32, amp: f32) {
    stream_push(hash((start ^ petalKey) + k * 0x9e3779b1))
    w = 4.2 to 5.2
    stream_pop()
    g = tau * float(k) / float(np) + 0.2 + t * spin
    b = bloom(t, 0.02 + float((k * 3) % np) * 0.035, k)
    side = 0
    if (sin(g) >= 0.0) { side = 1 }
    if (side == near && b > 0.02) {
      ca = cos(g)
      sa = sin(g)
      rt = 6.0 + 9.0 * min(1.2, b)
      h = 9.0 * b
      if (k % 2 == 1) { h = 7.0 * b }
      base = {cx + ca * 6.0, floorY - 1.0 + sa * 6.0 * sy}
      tip = {cx + ca * rt, floorY - 1.0 + sa * rt * sy - h}
      len = vec2.len(tip - base)
      if (len >= 1.5) {
        u = (tip - base) / len
        nr = {-u.y, u.x}
        wide = w * min(1.0, b) * (0.35 + 0.65 * abs(sa))
        // The outline at five stations along the petal.
        q1 = base + u * (len * 0.2)
        q2 = base + u * (len * 0.45)
        q3 = base + u * (len * 0.7)
        q4 = base + u * (len * 0.88)
        h1 = halfWidth(wide, 0.2)
        h2 = halfWidth(wide, 0.45)
        h3 = halfWidth(wide, 0.7)
        h4 = halfWidth(wide, 0.88)
        l1 = q1 + nr * h1
        l2 = q2 + nr * h2
        l3 = q3 + nr * h3
        l4 = q4 + nr * h4
        r1 = q1 - nr * h1
        r2 = q2 - nr * h2
        r3 = q3 - nr * h3
        r4 = q4 - nr * h4
        k0 = 1.0
        if (pass == 1) { k0 = amp }
        if (pass == 0) {
          body = 0.45
          if (near == 0) { body = 0.6 }
          poly(ink(cs[3], body), base.x, base.y, l1.x, l1.y, l2.x, l2.y, r2.x, r2.y, r1.x, r1.y)
          poly(ink(cs[4], body), r2.x, r2.y, l2.x, l2.y, l3.x, l3.y, l4.x, l4.y, tip.x, tip.y, r4.x, r4.y, r3.x, r3.y)
          vein = 0.85
          if (near == 0) { vein = 0.75 }
          line(base + u * (len * 0.15), q2, 1, ink(cs[5], vein))
          line(q2, base + u * (len * 0.85), 1, ink(cs[6], vein))
        }
        // The lit rim, warming towards the tip.
        rimA = 1.0
        if (pass == 1) { rimA = 0.5 }
        line(base, l1, 1, ink(cs[3], rimA * k0))
        line(base, r1, 1, ink(cs[3], rimA * k0))
        line(l1, l3, 1, ink(cs[5], rimA * k0))
        line(r1, r3, 1, ink(cs[5], rimA * k0))
        line(l3, tip, 1, ink(cs[6], rimA * k0))
        line(r3, tip, 1, ink(cs[6], rimA * k0))
        pixel(int(tip.x), int(tip.y), ink(cs[7], k0))
        if (pass == 1) { haze(tip, 5.0, cs[5], 0.35 * min(1.0, b) * amp) }
      }
    }
  }

  // A petal's half width at u (0 at the root, 1 at the tip).
  halfWidth(wide: f32, u: f32) -> f32 {
    return wide * pow(sin(3.14159 * pow(u, 0.6)), 0.7) + 0.2
  }

  // The hoop of light rising up the body, easing in and out, narrowing as it
  // climbs; it shrinks away once it tops out. Its near side burns white.
  hoop(t: f32, cs: list<color>, near: i32, pass: i32, amp: f32) {
    if (t >= lift0 && t <= lift1 + 0.12) {
      s = seg(t, lift0, lift1)
      y = floorY + topY * easeInOutSine(s)
      r = ringR + (12.0 - ringR) * s
      if (t > lift1) { r = r * (1.0 - (t - lift1) / 0.12) }
      if (r >= 0.5) {
        a0 = 3.14159
        if (near == 1) { a0 = 0.0 }
        k = 1.0
        if (near == 0) { k = 0.8 }
        if (pass == 1) { k = k * amp }
        for i in 0..16 {
          g0 = a0 + 3.14159 * float(i) / 16.0
          g1 = a0 + 3.14159 * float(i + 1) / 16.0
          col = cs[6]
          if (sin((g0 + g1) * 0.5) > 0.5) { col = cs[7] }
          line({cx + cos(g0) * r, y + sin(g0) * r * sy}, {cx + cos(g1) * r, y + sin(g1) * r * sy}, 1, ink(col, k))
          if (near == 1 && pass == 0) {
            line({cx + cos(g0) * (r - 0.5), y + 1.0 + sin(g0) * r * sy}, {cx + cos(g1) * (r - 0.5), y + 1.0 + sin(g1) * r * sy}, 1, cs[4])
          }
        }
        if (near == 1 && pass == 1) {
          for i in 0..5 { haze({cx + float(i - 2) * r * 0.45, y}, 8.0, cs[5], 0.32 * amp) }
        }
      }
    }
  }

  // Sparkles the hoop leaves on the body as it passes: they drift up a
  // little and fade, twinkling.
  stars(start: i32, t: f32, cs: list<color>, pass: i32, amp: f32) {
    for i in 0..16 {
      stream_push(hash((start ^ starKey) + i * 0x9e3779b1))
      ts = lift0 to lift1
      dx = -7.0 to 7.0
      vx = -4.0 to 4.0
      vy = 4.0 to 12.0
      life = 0.3 to 0.55
      white = chance(0.5)
      size = 0.6 to 1.6
      stream_pop()
      a = t - ts
      if (a > 0.0 && a < life) {
        y0 = floorY + topY * easeInOutSine(seg(ts, lift0, lift1))
        x = floor(cx + dx + vx * a)
        y = floor(y0 - vy * a)
        k = 1.0 - a / life
        col = cs[6]
        if (white == 1) { col = cs[7] }
        if (pass == 1) { k = k * amp }
        if (size * (1.0 - a / life) > 0.9) {
          rect(x - 1.0, y, 3.0, 1.0, ink(col, k * 0.7))
          rect(x, y - 1.0, 1.0, 3.0, ink(col, k * 0.7))
        }
        rect(x, y, 1.0, 1.0, ink(col, k))
      }
    }
  }

  // Motes riding a spiral up round the body: one from each petal as it
  // opens, and a ring of them from the hoop when it bursts. back = 1 draws
  // the parts of the spiral behind the body. At the end of its ride each
  // pops: a quick sparkle, then a heart or a twinkle floating up and fading.
  riders(start: i32, t: f32, cs: list<color>, np: i32, spin: f32, hearts: i32, back: i32, pass: i32, amp: f32) {
    total = np + 8
    for m in 0..total {
      stream_push(hash((start ^ moteKey) + m * 0x9e3779b1))
      riseA = 46.0 to 58.0
      lifeA = 0.75 to 0.95
      late = 0.0 to 0.06
      rB = 12.0 to 18.0
      yB = -2.0 to 4.0
      riseB = 14.0 to 34.0
      lifeB = 0.35 to 0.6
      stream_pop()
      t0 = 0.2 + float(m) * 0.05
      th0 = tau * float(m) / float(np) + 0.2 + t0 * spin
      r0 = ringR * 0.9
      y0 = -1.0
      w = 4.2
      rise = riseA
      life = lifeA
      kind = m % 2
      if (m >= np) {
        j = m - np
        t0 = lift1 + late
        th0 = tau * float(j) / 8.0
        r0 = rB
        y0 = topY + yB
        w = 3.6
        rise = riseB
        life = lifeB
        kind = (j + 1) % 2
      }
      if (m % 2 == 1) { w = -w }
      a = t - t0
      if (a >= 0.0) {
        if (a < life) {
          for j in 0..7 {
            aj = a - float(j) * 0.03
            if (aj >= 0.0) {
              th = th0 + w * aj
              r = r0 * (1.0 - 0.45 * aj / life)
              behind = 0
              if (sin(th) < 0.0) { behind = 1 }
              if (behind == back) {
                col = cs[5]
                if (j < 3) { col = cs[6] }
                if (j == 0) { col = cs[7] }
                k = 1.0 - float(j) / 7.0
                if (back == 1) { k = k * 0.6 }
                if (pass == 1) { k = k * amp }
                pixel(int(cx + cos(th) * r), int(floorY + y0 - rise * aj), ink(col, k))
              }
            }
          }
          if (pass == 1) {
            th = th0 + w * a
            behind = 0
            if (sin(th) < 0.0) { behind = 1 }
            if (behind == back) {
              hp = {cx + cos(th) * r0 * (1.0 - 0.45 * a / life), floorY + y0 - rise * a}
              g = 0.4
              if (back == 1) { g = 0.2 }
              haze(hp, 4.0, cs[5], g * amp)
            }
          }
        } else if (back == 0) {
          u = (a - life) / 0.36
          if (u < 1.0) {
            th = th0 + w * life
            p = {cx + cos(th) * r0 * 0.55, floorY + y0 - rise * life}
            k = 1.0 - smoothstep(0.5, 1.0, u)
            if (u < 0.12) { sparkle(p, 3.0, cs, pass, amp) }
            else if (kind == 1 && hearts == 1) { heart(p - {0.0, u * 6.0}, cs, k, pass, amp) }
            else { sparkle(p - {0.0, u * 5.0}, 1.0 + 2.0 * k * (0.7 + 0.3 * sin(a * 30.0)), cs, pass, amp * 0.6) }
          }
        }
      }
    }
  }

  // A tiny heart of light, five pixels wide: a warm rim, a cream body, a
  // white glint.
  heart(p: vec2, cs: list<color>, a: f32, pass: i32, amp: f32) {
    x = floor(p.x) - 2.0
    y = floor(p.y) - 2.0
    k = a
    if (pass == 1) { k = a * amp }
    // The rim: the heart's shape pushed one pixel each way.
    for d in 0..4 {
      ox = 0.0
      oy = 0.0
      if (d == 0) { ox = -1.0 }
      if (d == 1) { ox = 1.0 }
      if (d == 2) { oy = -1.0 }
      if (d == 3) { oy = 1.0 }
      heartShape(x + ox, y + oy, ink(cs[3], k * 0.9), ink(cs[3], k * 0.9))
    }
    heartShape(x, y, ink(cs[6], k), ink(cs[5], k))
    rect(x + 1.0, y + 1.0, 1.0, 1.0, ink(cs[7], k))
    if (pass == 1) { haze(p, 6.0, cs[5], 0.4 * a * amp) }
  }

  // The heart's pixels with its top left at x, y: ".#.#." "#####" ".###." "..#.."
  heartShape(x: f32, y: f32, top: color, low: color) {
    rect(x + 1.0, y, 1.0, 1.0, top)
    rect(x + 3.0, y, 1.0, 1.0, top)
    rect(x, y + 1.0, 5.0, 1.0, top)
    rect(x + 1.0, y + 2.0, 3.0, 1.0, low)
    rect(x + 2.0, y + 3.0, 1.0, 1.0, low)
  }

  // A four-pointed glint: thin rays round a white heart.
  sparkle(p: vec2, size: f32, cs: list<color>, pass: i32, amp: f32) {
    if (size >= 1.0) {
      k = 1.0
      if (pass == 1) { k = amp }
      x = floor(p.x) + 0.5
      y = floor(p.y) + 0.5
      line({x - size, y}, {x + size, y}, 1, ink(cs[5], k))
      line({x, y - size}, {x, y + size}, 1, ink(cs[5], k))
      line({x - size * 0.5, y}, {x + size * 0.5, y}, 1, ink(cs[6], k))
      line({x, y - size * 0.5}, {x, y + size * 0.5}, 1, ink(cs[6], k))
      rect(x - 0.5, y - 0.5, 1.0, 1.0, ink(cs[7], k))
    } else {
      k = 1.0
      if (pass == 1) { k = amp }
      rect(floor(p.x), floor(p.y), 1.0, 1.0, ink(cs[7], k))
    }
  }

  // ---- toolkit ---------------------------------------------------------------
  // A soft round glow for the light mask: nested discs that add up to alpha a
  // in the middle and fade out to radius r, so even the bloom stays soft.
  haze(p: vec2, r: f32, col: color, a: f32) {
    for i in 0..4 {
      k = 1.0 - float(i) * 0.24
      oval(p, r * k, r * k, ink(col, a * (0.12 + 0.08 * float(i))))
    }
  }
  // The colour with its alpha scaled by a (clamped to 0..1).
  ink(c: color, a: f32) -> color {
    return color.set.a(c, int(clamp(a, 0.0, 1.0) * float(c.a)))
  }
  // How far t is from a to b, clamped to 0..1.
  seg(t: f32, a: f32, b: f32) -> f32 {
    return clamp((t - a) / (b - a), 0.0, 1.0)
  }
  // Springs past 1 and settles (s sets the overshoot).
  easeOutBack(x: f32, s: f32) -> f32 {
    y = x - 1.0
    return 1.0 + (s + 1.0) * y * y * y + s * y * y
  }
  // Pulls back first, then goes (s sets the pull).
  easeInBack(x: f32, s: f32) -> f32 {
    return (s + 1.0) * x * x * x - s * x * x
  }
  // Slow at both ends.
  easeInOutSine(x: f32) -> f32 {
    return 0.5 - 0.5 * cos(3.14159 * x)
  }
  // Eight steps from a dark shade of the colour, through it, to white.
  rampFrom(c: color) -> list<color> {
    base = color.set.a(c, 255)
    return [color.mix(#08060c, base, 0.2), color.mix(#08060c, base, 0.4), color.mix(#08060c, base, 0.62),
            color.mix(#08060c, base, 0.84), base, color.mix(base, #fff8e8, 0.35), color.mix(base, #fff8e8, 0.68), #ffffff]
  }
}
